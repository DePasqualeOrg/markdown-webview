    <script>PLACEHOLDER_SCRIPT</script>
    <style>
        PLACEHOLDER_STYLESHEET
    </style>
    <style>
        :root {
            color-scheme: light dark !important;
            --font-size-multiplier: PLACEHOLDER_FONT_SIZE_MULTIPLIER;
        }

        html,
        body {
            overscroll-behavior: none !important;
            margin: 0 !important;
        }

        body::-webkit-scrollbar {
            display: none !important;
        }

        #markdown-rendered>*:first-child {
            margin-top: 0 !important;
        }

        #markdown-rendered>*:last-child {
            margin-bottom: 0 !important;
        }

        .code-block-wrapper {
            position: relative;
        }
        
        /* Position button in the top-right corner */
        .copy-code-button {
            border: none;
            border-radius: 4px;
            padding: 6px;
            cursor: pointer;
            opacity: 1;
            position: absolute;
            top: 5px;
            right: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            z-index: 10;
        }

        .copy-code-button svg {
            fill: #007AFF; /* iOS accent blue color */
        }

        .copy-code-button.copied {
            opacity: 1;
        }
    </style>
